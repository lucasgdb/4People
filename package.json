{
	"name": "4people",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "pnpm --filter @4people/web dev",
		"build": "pnpm --filter @4people/web build",
		"start": "pnpm --filter @4people/web start",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r test",
		"gen:routes": "pnpm --filter @4people/web gen:routes",
		"indexnow": "pnpm --filter ./apps/web indexnow"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"typescript": "7.0.2"
	}
}
